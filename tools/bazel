#!/usr/bin/env bash
# Thin wrapper that delegates to bazelisk. Bazelisk reads .bazelversion
# and downloads the matching Bazel release on demand.
#
# Install bazelisk once (any of):
#   brew install bazelisk
#   npm install -g @bazel/bazelisk
#   go install github.com/bazelbuild/bazelisk@latest
set -euo pipefail

if ! command -v bazelisk >/dev/null 2>&1; then
  echo "bazelisk not found on PATH. Install it: https://github.com/bazelbuild/bazelisk" >&2
  exit 127
fi

exec bazelisk "$@"
